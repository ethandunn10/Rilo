{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    {
      "kind": "folder",
      "path": "Rilo",
      "target-membership": [
        "Rilo",
      ],
      "membership-exceptions": [
        {
          "target": "RiloShieldConfiguration",
          "inclusions": [
            "Assets.xcassets",
            "ScreenTimeReal/Shared/AppGroup.swift",
            "ScreenTimeReal/Shared/RiloShared.swift",
            "ScreenTimeReal/Shared/RiloTokens.swift",
          ],
        }, {
          "target": "RiloShieldAction",
          "inclusions": [
            "ScreenTimeReal/Shared/AppGroup.swift",
            "ScreenTimeReal/Shared/RiloShared.swift",
            "ScreenTimeReal/Shared/RiloTokens.swift",
          ],
        }, {
          "target": "RiloActivityMonitor",
          "inclusions": [
            "ScreenTimeReal/Shared/AppGroup.swift",
            "ScreenTimeReal/Shared/RiloShared.swift",
            "ScreenTimeReal/Shared/RiloTokens.swift",
          ],
        }, {
          "target": "RiloWidgetExtension",
          "inclusions": [
            "Assets.xcassets",
            "ScreenTimeReal/Shared/AppGroup.swift",
            "ScreenTimeReal/Shared/RiloShared.swift",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "RiloShieldConfiguration",
      "target-membership": [
        "RiloShieldConfiguration",
      ],
      "membership-exceptions": [
        {
          "target": "RiloShieldConfiguration",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "RiloShieldAction",
      "target-membership": [
        "RiloShieldAction",
      ],
      "membership-exceptions": [
        {
          "target": "RiloShieldAction",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "RiloActivityMonitor",
      "target-membership": [
        "RiloActivityMonitor",
      ],
      "membership-exceptions": [
        {
          "target": "RiloActivityMonitor",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "RiloWidget",
      "target-membership": [
        "RiloWidgetExtension",
      ],
      "membership-exceptions": [
        {
          "target": "RiloWidgetExtension",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        {
          "path": "<SDK>/System/Library/Frameworks/ManagedSettings.framework",
          "target-membership": [
            "RiloShieldConfiguration/frameworks",
            "RiloShieldAction/frameworks",
          ],
        },
        { "path": "<SDK>/System/Library/Frameworks/ManagedSettingsUI.framework", "target-membership": [ "RiloShieldConfiguration/frameworks" ] },
        { "path": "<SDK>/System/Library/Frameworks/DeviceActivity.framework", "target-membership": [ "RiloActivityMonitor/frameworks" ] },
        { "path": "<SDK>/System/Library/Frameworks/WidgetKit.framework", "target-membership": [ "RiloWidgetExtension/frameworks" ] },
        { "path": "<SDK>/System/Library/Frameworks/SwiftUI.framework", "target-membership": [ "RiloWidgetExtension/frameworks" ] },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Rilo.app", "id": "CC433E37309A91D2001A650C", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/RiloShieldConfiguration.appex", "id": "CC6B403630A132CA0072519C", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Rilo/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/RiloShieldAction.appex", "id": "CC6B404B30A133130072519C", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Rilo/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/RiloActivityMonitor.appex", "id": "CC6B405B30A133340072519C", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Rilo/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/RiloWidgetExtension.appex", "id": "CC6B406C30A1335B0072519C", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Rilo/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "Rilo",
      "id": "CC433E36309A91D2001A650C",
      "product": "Products/Rilo.app",
      "product-type": "application",
      "dependencies": [
        "RiloShieldConfiguration",
        "RiloShieldAction",
        "RiloActivityMonitor",
        "RiloWidgetExtension",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "DEVELOPMENT_TEAM": "XT99CW8757",
        "ENABLE_PREVIEWS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Config/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Rilo",
        "INFOPLIST_KEY_NSCalendarsFullAccessUsageDescription": "Rilo reads your calendar on your phone to plan your day around practices, tests and plans, and never changes your events.",
        "INFOPLIST_KEY_NSMicrophoneUsageDescription": "Rilo listens only while you hold the talk button so you can tell him about your day.",
        "INFOPLIST_KEY_NSPhotoLibraryAddUsageDescription": "Rilo saves your weekly share card to your photos only when you tap save image.",
        "INFOPLIST_KEY_NSSpeechRecognitionUsageDescription": "Rilo turns what you say into text right on your phone so you can talk to him instead of typing.",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents": "YES",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPhone": "UIInterfaceOrientationPortrait",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.ethandunn.Rilo",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
